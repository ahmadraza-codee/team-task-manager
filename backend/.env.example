PORT=5000
SESSION_SECRET=change-me-to-a-long-random-string
# DATABASE_URL is commented out by default so the app runs instantly in in-memory (dev/demo) mode.
# To use PostgreSQL instead, uncomment the line below and set your REAL password + database name:
#DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/team_task_manager
CLIENT_URL=http://localhost:5173
NODE_ENV=development
